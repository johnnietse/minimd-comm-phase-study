+      if (chunk_count % (50 * 1024 * 1024 / (int)buf_size + 1) == 0) {
+        std::printf("  ... transferred %.2f / %.2f MB (elapsed %.2f s)\n",
+                    bytes_sent / (1024.0 * 1024.0),
